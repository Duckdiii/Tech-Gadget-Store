# =============================================================================
# TechGadgetStore - Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control — it is listed in .gitignore.
# =============================================================================

# --- Database (Supabase PostgreSQL) ------------------------------------------
DB_URL=jdbc:postgresql://<host>:<port>/postgres?sslmode=require
DB_USERNAME=postgres.<your-project-ref>
DB_PASSWORD=<your-db-password>

# --- Email (Gmail SMTP) -------------------------------------------------------
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=<your-gmail-address>
EMAIL_SMTP_PASS=<your-gmail-app-password>
EMAIL_FROM_NAME=TechStore System
EMAIL_FROM_ADDRESS=<your-gmail-address>
EMAIL_REPLY_TO_MODE=customer
EMAIL_REPLY_TO_ADDRESS=

# --- JWT ----------------------------------------------------------------------
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=<your-long-random-jwt-secret>

# --- Payment General ------------------------------------------------------------
# true = mọi cổng thanh toán dùng cấu hình Sandbox (mặc định, an toàn).
# false = cho phép từng cổng dùng Production NẾU cổng đó cũng bật MOMO_PROD_ENABLED /
# VNPAY_PROD_ENABLED = true bên dưới. Thiếu 1 trong 2 điều kiện, hệ thống tự rơi về Sandbox.
PAYMENT_SANDBOX_MODE=true
PAYMENT_TIMEOUT_MINUTES=15
# Chỉ dùng ở Dev/Test để tự động hoàn tất thanh toán giả lập — PHẢI là false ở Production.
PAYMENT_TEST_AUTO_COMPLETE=false

# --- MoMo Payment Gateway (Sandbox) ------------------------------------------
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=<your-momo-partner-code>
MOMO_ACCESS_KEY=<your-momo-access-key>
MOMO_SECRET_KEY=<your-momo-secret-key>
MOMO_PUBLIC_KEY=
MOMO_REDIRECT_URL=http://localhost:8080/api/payments/momo/return
MOMO_IPN_URL=https://<your-ngrok-or-domain>/api/payments/momo/ipn
MOMO_REQUEST_TYPE=captureWallet
MOMO_PARTNER_NAME=TechStore
MOMO_STORE_ID=TechStore001
MOMO_LANG=vi

# --- MoMo Payment Gateway (Production) ---------------------------------------
# Chỉ cần điền khi go-live thanh toán MoMo thật.
# BẮT BUỘC set true (kèm PAYMENT_SANDBOX_MODE=false) thì hệ thống mới thực sự dùng bộ config này.
MOMO_PROD_ENABLED=false
MOMO_ENDPOINT_PROD=https://payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE_PROD=<your-momo-prod-partner-code>
MOMO_ACCESS_KEY_PROD=<your-momo-prod-access-key>
MOMO_SECRET_KEY_PROD=<your-momo-prod-secret-key>
MOMO_PUBLIC_KEY_PROD=
MOMO_REDIRECT_URL_PROD=https://<your-domain>/api/payments/momo/return
MOMO_IPN_URL_PROD=https://<your-domain>/api/payments/momo/ipn
MOMO_REQUEST_TYPE_PROD=captureWallet
MOMO_PARTNER_NAME_PROD=TechStore
MOMO_STORE_ID_PROD=TechStore001
MOMO_LANG_PROD=vi

# --- VNPay Payment Gateway (Sandbox) -----------------------------------------
VNPAY_VERSION=2.1.0
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=<your-vnpay-tmn-code>
VNPAY_HASH_SECRET=<your-vnpay-hash-secret>
# Mặc định dùng chung giá trị với VNPAY_HASH_SECRET nếu không set riêng.
VNPAY_SECURE_SECRET=<your-vnpay-hash-secret>
VNPAY_RETURN_URL=https://<your-ngrok-or-domain>/api/payments/vnpay/return
VNPAY_IPN_URL=https://<your-ngrok-or-domain>/api/payments/vnpay/ipn
VNPAY_LOCALE=vn
VNPAY_ORDER_TYPE=200000

# --- VNPay Payment Gateway (Production) --------------------------------------
# Chỉ cần điền khi go-live thanh toán VNPay thật.
# BẮT BUỘC set true (kèm PAYMENT_SANDBOX_MODE=false) thì hệ thống mới thực sự dùng bộ config này.
VNPAY_PROD_ENABLED=false
VNPAY_VERSION_PROD=2.1.0
VNPAY_PAYMENT_URL_PROD=https://payment.vnpayment.vn/vpcpay.html
VNPAY_URL_PROD=https://payment.vnpayment.vn/vpcpay.html
VNPAY_TMN_CODE_PROD=<your-vnpay-prod-tmn-code>
VNPAY_HASH_SECRET_PROD=<your-vnpay-prod-hash-secret>
VNPAY_SECURE_SECRET_PROD=<your-vnpay-prod-hash-secret>
VNPAY_RETURN_URL_PROD=https://<your-domain>/api/payments/vnpay/return
VNPAY_IPN_URL_PROD=https://<your-domain>/api/payments/vnpay/ipn
VNPAY_LOCALE_PROD=vn
VNPAY_ORDER_TYPE_PROD=200000

# --- CORS -----------------------------------------------------------------------
# Domain(s) của frontend được phép gọi API, phân cách bởi dấu phẩy.
# BẮT BUỘC set giá trị thật khi deploy Production, nếu không sẽ mặc định chỉ cho phép
# http://localhost:5173 và frontend production sẽ bị chặn bởi CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Chatbot (Google Gemini API) -----------------------------------------------
GEMINI_API_KEY=<your-gemini-api-key>

# --- Swagger UI / OpenAPI Docs ------------------------------------------------
# Set to false on Production to disable Swagger UI & API docs
SPRINGDOC_ENABLED=true

# --- Logging & SQL Debugging --------------------------------------------------
# Set LOG_LEVEL_SQL=DEBUG in Dev if you want to inspect SQL queries via SLF4J logger
LOG_LEVEL_SQL=INFO
LOG_LEVEL_SQL_BIND=INFO
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false


